# Copy to backend/.env and adjust.

# false -> TorchModelProvider: trained weights from WEIGHTS_DIR (default)
# true  -> MockModelProvider: simulated outputs, for UI development/tests only
USE_MOCK_MODELS=false

# two_stage (Normal/Pneumonia -> Bacterial/Viral) or three_class (single Normal/Bacterial/Viral model)
CLASSIFICATION_MODE=two_stage
WEIGHTS_DIR=./weights
DEVICE=auto

# Preprocessing defaults (a model's weights/<name>.json written by training overrides these)
IMAGE_SIZE=224
USE_CLAHE=true

# Below this calibrated confidence, results are flagged for expert review
DEFAULT_THRESHOLD=0.75

# Analysis history (thumbnail + results only). Set false to never store anything.
HISTORY_ENABLED=true
# DATABASE_URL=sqlite:///./data/history.db

MIN_RESOLUTION=128
WARN_RESOLUTION=512
MAX_UPLOAD_MB=25
MOCK_LATENCY_MS=150
# CORS_ORIGINS=["http://localhost:5173"]
